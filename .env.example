# Optional OpenAI key. Without it, the default provider is local Ollama.
OPENAI_API_KEY=

# Used by scripts/ingest_all.py for SEC EDGAR downloads.
SEC_EMAIL=

# Set to 1 only when allowing SentenceTransformers to download a model.
TEMPORAL_GUARD_ALLOW_MODEL_DOWNLOAD=0

# Must match the dimension used by the persisted Chroma collection.
TEMPORAL_GUARD_EMBED_DIM=384
